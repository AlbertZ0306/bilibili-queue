{
  "manifest_version": 3,
  "name": "bilibili-queue",
  "version": "1.6.3",
  "description": "从 B 站视频页一键添加或粘贴链接，支持顺序/逆序播放、拖动排序、1～3 倍速、实时进度、标题与时长、分 P 和列表循环。",
  "minimum_chrome_version": "112",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.bilibili.com/*",
    "https://b23.tv/*",
    "https://api.bilibili.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "bilibili-queue",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "options_page": "popup.html",
  "content_scripts": [
    {
      "matches": [
        "https://www.bilibili.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.bilibili.com/*"],
      "css": ["quick-add.css"],
      "js": ["quick-add.js"],
      "run_at": "document_idle"
    }
  ]
}
